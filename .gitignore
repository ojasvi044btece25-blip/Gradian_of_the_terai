# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# Testing
.pytest_cache/
.coverage
htmlcov/

# API job outputs (generated at runtime — can be large GeoTIFFs)
results/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Satellite data (never commit raw imagery)
*.tif
*.tiff
*.geojson
# Allow test fixtures to be committed if explicitly tracked
!tests/fixtures/*.tif
